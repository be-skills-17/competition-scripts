{
  "openapi": "3.0.3",
  "info": {
    "title": "Template API",
    "version": "1.0.0",
    "description": "Example API provided to the competitors. Each competitor has their own instance and database."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Status of the API",
        "responses": {
          "200": {
            "description": "The API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "api": { "type": "string", "example": "template" },
                    "competitor": { "type": "string", "example": "comp01" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items": {
      "get": {
        "summary": "List the items",
        "responses": {
          "200": {
            "description": "All the items, by id",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": { "name": { "type": "string", "example": "Keyboard" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created item",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } }
          },
          "422": {
            "description": "Missing or empty name",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Keyboard" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
